# Bipros EPPM deployment — environment overrides.
# Copy to `.env` and edit before running deploy.sh / deploy.ps1.
# Anything not set falls back to the default in docker-compose.yml.

# ──────────────────────────────── Postgres ────────────────────────────────
POSTGRES_USER=bipros
POSTGRES_PASSWORD=bipros_dev
POSTGRES_DB=bipros
PG_HOST_PORT=5433

# ──────────────────────────────── Backend ─────────────────────────────────
# First boot: prod,init-prod (admin gets seeded).
# Subsequent boots: switch to "prod" via:  BIPROS_PROFILES=prod docker compose up -d bipros-api
BIPROS_PROFILES=prod,init-prod
API_HOST_PORT=8080
JWT_SECRET=change-me-32-byte-random-prod-secret-please-rotate
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ──────────────────────────────── AI ──────────────────────────────────────
# KEK encrypts persisted LLM API keys. Required in non-dev profiles.
# ROTATE before exposing to anything beyond a laptop.
BIPROS_AI_ENABLED=true
BIPROS_AI_KEK=Vd/RdHKwlLA1vFuDVUr/ou0CMHAsha99Cfi8UXzXUlA=
# Optional — set if you want /v1/ai/chat to hit Anthropic.
# ANTHROPIC_API_KEY=

# ─────────────────────────── Other services ───────────────────────────────
# If another container on the host already binds 6379 (e.g. a 'unity-redis'
# from another project), bump this to a free port like 6380. Detection in
# deploy.sh will tell you the conflicting container name.
REDIS_HOST_PORT=6379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_USER=bipros
CLICKHOUSE_PASSWORD=bipros_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
DOCLING_PORT=5001
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@bipros.io
PGADMIN_PASSWORD=admin

# ─────────────────────────────── JVM tuning ───────────────────────────────
JAVA_OPTS="-Xmx2g -XX:MaxRAMPercentage=75"
DB_POOL_MAX=60
