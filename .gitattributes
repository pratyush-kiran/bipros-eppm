# Enforce LF line endings for cross-platform safety.
# Shell + Python scripts must be LF — CRLF in a shebang breaks Linux.
*.sh        text eol=lf
*.py        text eol=lf
*.bash      text eol=lf

# Windows-only scripts stay CRLF.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Source/config/docs — repo-normal LF.
*.java      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
*.xml       text eol=lf
*.toml      text eol=lf
*.css       text eol=lf

# Binary — no conversion.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.xlsx      binary
*.xls       binary
*.woff      binary
*.woff2     binary
