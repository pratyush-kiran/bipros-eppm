        <insert schemaName="resource" tableName="expense_categories">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="code" value="SITE_OFFICE"/>
            <column name="name" value="Site office"/>
            <column name="description" value="Stationery, internet, photocopy, courier"/>
            <column name="dbs_section" value="G"/>
            <column name="default_taxable" valueBoolean="true"/>
            <column name="default_tax_rate_pct" valueNumeric="18.00"/>
            <column name="sort_order" valueNumeric="50"/>
            <column name="created_by" value="system"/>
            <column name="updated_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        <insert schemaName="resource" tableName="expense_categories">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="code" value="LOCAL_PURCHASE"/>
            <column name="name" value="Local material purchase"/>
