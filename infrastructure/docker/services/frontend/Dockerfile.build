# Multi-stage build — no host Node/pnpm required.
# Build context: frontend/ directory
#
# Stage 1: install deps + compile Next.js standalone bundle inside Docker
# Stage 2: copy the standalone output into a lean Node runtime image

# ── Stage 1: build ─────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Cache dependency layer — only re-downloaded when lockfile changes
COPY package.json pnpm-lock.yaml .npmrc ./
# pnpm 10 blocks native build scripts by default; allow them for Docker builds
RUN echo "dangerously-allow-all-builds=true" >> .npmrc && \
    pnpm install --frozen-lockfile

# NEXT_PUBLIC_* vars are baked into the JS bundle at build time.
# Leave empty so axios uses relative URLs proxied by nginx.
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1

COPY . .
RUN pnpm run build

# ── Stage 2: runtime ───────────────────────────────────────────────────────
FROM node:22-alpine AS runtime

RUN addgroup -S -g 1001 nodejs && \
    adduser -S -u 1001 -G nodejs nextjs

WORKDIR /app

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:3000/ > /dev/null || exit 1

CMD ["node", "server.js"]
