<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
      Ad-hoc activity expenses (plan §3): master data table for the categories that drive
      the DBS expense capture. Each category maps to a DBS section letter (A/B/C/D/E/F/G)
      so manually-entered expenses bucket into the right section at read time.

      Ships with 10 seed defaults so the feature is usable on day 1 without manual setup.
    -->

    <changeSet id="expense-categories-1-create" author="claude">
        <createTable schemaName="resource" tableName="expense_categories">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="dbs_section" type="CHAR(1)">
                <constraints nullable="false"/>
            </column>
            <column name="default_taxable" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="default_tax_rate_pct" type="NUMERIC(5,2)"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="version" type="BIGINT"/>
        </createTable>

        <addUniqueConstraint schemaName="resource"
                             tableName="expense_categories"
                             columnNames="code"
                             constraintName="uk_expense_categories_code"/>

        <sql>
            ALTER TABLE resource.expense_categories
            ADD CONSTRAINT ck_expense_categories_dbs_section
            CHECK (dbs_section IN ('A','B','C','D','E','F','G'));
        </sql>

        <rollback>
            <dropTable schemaName="resource" tableName="expense_categories"/>
        </rollback>
    </changeSet>

    <changeSet id="expense-categories-2-seed-defaults" author="claude">
        <comment>10 default categories covering the common ad-hoc expense buckets.</comment>
        <insert schemaName="resource" tableName="expense_categories">
            <column name="id" valueComputed="gen_random_uuid()"/>
