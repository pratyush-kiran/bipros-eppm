            <column name="name" value="Transport / Vehicle hire"/>
            <column name="description" value="Diesel coupons, taxi fares, lorry hire, parking, tolls"/>
            <column name="dbs_section" value="G"/>
            <column name="sort_order" valueNumeric="10"/>
            <column name="created_by" value="system"/>
            <column name="updated_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        <insert schemaName="resource" tableName="expense_categories">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="code" value="REPAIR"/>
            <column name="name" value="Emergency repair / Maintenance"/>
            <column name="description" value="Unplanned machinery / tool repair, spare-part purchase"/>
            <column name="dbs_section" value="G"/>
