# Committed production defaults (non-secret only).
# Next.js loads this during `next build` / `next start` (NODE_ENV=production).
#
# basePath is inlined at BUILD time, so this must be present when the prod image
# is built — otherwise assets resolve to /_next/... (no /v2) and 404 behind the
# /v2 reverse proxy. See src/lib/basePath.ts / next.config.ts.
NEXT_PUBLIC_BASE_PATH=/v2
