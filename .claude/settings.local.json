{
  "permissions": {
    "allow": [
      "Bash(xargs -I {} dirname {})",
      "Bash(xargs -I {} basename {})",
      "Bash(xargs cat *)",
      "Bash(xargs -I {} sh -c 'echo \"File: {}\"; head -30 \"{}\"')",
      "Bash(xargs ls *)",
      "Bash(chmod +x *)",
      "PowerShell(Copy-Item *)",
      "PowerShell(docker exec bipros-postgres *)",
      "Bash(xargs grep *)",
      "Bash(docker compose *)",
      "Bash(docker images *)"
    ]
  }
}
