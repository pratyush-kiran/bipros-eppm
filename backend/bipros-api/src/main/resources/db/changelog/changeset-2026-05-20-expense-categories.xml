            <column name="updated_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>
        <insert schemaName="resource" tableName="expense_categories">
            <column name="id" valueComputed="gen_random_uuid()"/>
            <column name="code" value="MISC"/>
            <column name="name" value="Miscellaneous"/>
            <column name="description" value="Catch-all for ad-hoc expenses that don't fit another category"/>
            <column name="dbs_section" value="G"/>
            <column name="sort_order" valueNumeric="99"/>
            <column name="created_by" value="system"/>
            <column name="updated_by" value="system"/>
            <column name="version" valueNumeric="0"/>
        </insert>

        <rollback>
            <delete schemaName="resource" tableName="expense_categories">
                <where>code IN ('TRANSPORT','REPAIR','CATERING','SAFETY','SITE_OFFICE','LOCAL_PURCHASE','ADHOC_FUEL','SUBCONTRACT','HONORARIUM','MISC')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
