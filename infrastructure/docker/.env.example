# infrastructure/docker/.env.example
# Docker Compose environment variables.
# Copy to infrastructure/docker/.env and fill in secrets before running.
# Never commit the actual .env file.

# ── Application version ───────────────────────────────────────────────────
APP_VERSION=latest

# ── Port bindings (host-side) ─────────────────────────────────────────────
# Nginx (main entry point)
NGINX_PORT=65000

# Postgres (exposed for IDE/DB tools)
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# pgAdmin
PGADMIN_PORT=5050

# ClickHouse (analytics)
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Root superuser used by the Docker init entrypoint only
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=bipros

# Application-level credentials (created by 01-init-db.sql)
DB_USERNAME=bipros
DB_PASSWORD=bipros_dev

# ── pgAdmin ───────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@bipros.local
PGADMIN_PASSWORD=admin

# ── ClickHouse ────────────────────────────────────────────────────────────
CLICKHOUSE_USER=bipros
CLICKHOUSE_PASSWORD=bipros_dev

# ── MinIO ─────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_BUCKET=sentinel-tiles

# ── Spring Boot ───────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# JWT secret — CHANGE THIS before any non-local deployment.
# Must be a strong random string of at least 64 characters.
JWT_SECRET=CHANGE_ME_use_a_long_random_secret_at_least_64_chars_for_HS256

# ── JVM tuning ────────────────────────────────────────────────────────────
# Overridable per-environment; docker-compose.override.yml sets the default
BACKEND_JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# ── Frontend ──────────────────────────────────────────────────────────────
# Public API base URL as seen by the user's browser
# Leave empty for production (nginx proxies API calls relatively).
# Set to http://localhost:<NGINX_PORT> only for local non-Docker IDE dev.
NEXT_PUBLIC_API_URL=

# ── Swagger / OpenAPI ─────────────────────────────────────────────────────
# Explicit server URL shown in Swagger UI. Set this to the public base URL
# (including scheme and port if non-standard) so Swagger "Try it out" calls
# hit the correct endpoint. Leave blank to let Spring auto-detect.
SWAGGER_SERVER_URL=https://demo.unitysphere.site:4001

# ── External APIs (optional) ──────────────────────────────────────────────
# Sentinel Hub / CDSE credentials for satellite imagery ingestion
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Anthropic Claude API key for AI-based progress analysis
ANTHROPIC_API_KEY=
