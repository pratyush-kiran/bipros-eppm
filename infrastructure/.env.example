# infrastructure/.env.example
# Top-level infrastructure environment variables.
# These drive the setup-local.sh script and CI pipelines.
# Copy to infrastructure/.env and fill in project-specific values.

# ── Project identity ──────────────────────────────────────────────────────
PROJECT_NAME=bipros-eppm
COMPOSE_PROJECT_NAME=bipros-eppm

# ── Docker Compose file selection ─────────────────────────────────────────
# Relative to infrastructure/docker/
COMPOSE_FILE=docker-compose.yml
COMPOSE_OVERRIDE_FILE=docker-compose.override.yml

# ── Registry (for CI/CD image pushes) ────────────────────────────────────
# Leave blank for local-only builds
IMAGE_REGISTRY=
IMAGE_TAG=latest

# ── Host machine ports — change only if defaults conflict ─────────────────
NGINX_HOST_PORT=65000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
PGADMIN_HOST_PORT=5050

# ── Secrets — MUST be overridden before non-local usage ──────────────────
DB_PASSWORD=bipros_dev
MINIO_ROOT_PASSWORD=minio123
JWT_SECRET=CHANGE_ME_use_a_long_random_secret_at_least_64_chars_for_HS256

# ── Optional external services ────────────────────────────────────────────
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
ANTHROPIC_API_KEY=
